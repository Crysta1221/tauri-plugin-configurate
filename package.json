{
  "name": "tauri-plugin-configurate-api",
  "version": "0.6.0",
  "description": "Tauri v2 plugin for type-safe application configuration management.",
  "keywords": [
    "config",
    "configuration",
    "keyring",
    "tauri",
    "tauri-plugin"
  ],
  "homepage": "https://github.com/Crysta1221/tauri-plugin-configurate",
  "bugs": {
    "url": "https://github.com/Crysta1221/tauri-plugin-configurate/issues"
  },
  "license": "MIT",
  "author": "Crysta1221",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crysta1221/tauri-plugin-configurate.git"
  },
  "files": [
    "dist-js",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist-js/index.cjs",
  "module": "./dist-js/index.js",
  "types": "./dist-js/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist-js/index.d.ts",
        "default": "./dist-js/index.js"
      },
      "require": {
        "types": "./dist-js/index.d.cts",
        "default": "./dist-js/index.cjs"
      }
    },
    "./provider": {
      "import": {
        "types": "./dist-js/provider.d.ts",
        "default": "./dist-js/provider.js"
      },
      "require": {
        "types": "./dist-js/provider.d.cts",
        "default": "./dist-js/provider.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:sync": "bun run build && cd examples/tauri-app && pnpm install",
    "check:dist": "node scripts/check-dist-types.mjs",
    "prepublishOnly": "bun run build",
    "pretest": "bun run build",
    "test": "bun test guest-js/*.test.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/web": "^0.0.366",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2.11.0"
  }
}
